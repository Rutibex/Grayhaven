    {
      "id": "quest.morrowwood",
      "name": "The Morrowwood Road",
      "giver": "npc.lena",
      "recipient": "npc.lena",
      "description": "Two tidehounds have claimed the western trail. Defeat the Morrowwood Tidehound and Trail Tidehound, then report to Lena at the east town gate. Clearing them will give the netmakers a safe route through the wood.",
      "completion": "Lena records the cleared trail. The western road belongs to travellers again.",
      "fame": 100,
      "karma": 50,
      "objectives": [
        {
