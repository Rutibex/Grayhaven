          "kind": "visit",
          "target": "cellar1.room1",
          "text": "Enter the upper Drowned Cellars",
          "amount": 1
        },
        {
          "id": "key",
          "kind": "collect",
          "target": "world.item.cellar.key",
          "text": "Carry the Brass Vault Key",
          "amount": 1
        },
        {
          "id": "lever",
          "kind": "object",
          "target": "cellar.lever",
          "text": "Raise the Lower Ward portcullis",
          "amount": 1
        },
        {
          "id": "keeper",
          "kind": "kill",
          "target": "encounter.lower.boss",
          "text": "Defeat the Lantern Keeper",
          "amount": 1
        },
        {
          "id": "heart",
          "kind": "obtain",
          "target": "quest.item.lantern-heart",
          "text": "Recover the Lantern Heart",
          "amount": 1
        },
        {
          "id": "restore",
          "kind": "restore",
          "target": "stairs.beacon",
          "text": "Install the heart at the Broken Beacon",
          "amount": 1
        }
      ],
      "rewards": [
        {
          "definition": "greyhaven.item.silver-marks",
          "amount": 260
        },
        {
          "definition": "greyhaven.item.mariner-greatblade",
          "amount": 1
