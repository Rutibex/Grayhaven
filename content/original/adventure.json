    },
    {
      "id": "quest.forge",
      "name": "A Spark for the Anchor Forge",
      "giver": "npc.orrin",
      "recipient": "npc.orrin",
      "description": "Orrin needs three tide crystals to temper a replacement beacon bracket. Carry them and mark them as quest items before returning. Marked supplies cannot be sold, thrown or dropped until you unmark them or turn them in.",
      "completion": "Orrin fits the new bracket and pays for exactly three crystals. Any extra marked supplies are yours again.",
      "fame": 75,
      "karma": 40,
      "objectives": [
