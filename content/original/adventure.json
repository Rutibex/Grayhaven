        }
      ],
      "rewards": [
        {
          "definition": "greyhaven.item.silver-marks",
          "amount": 90
        },
        {
          "definition": "greyhaven.item.bandage",
          "amount": 5
        }
      ]
    },
    {
      "id": "quest.harbour",
      "name": "Letters for the Harbour",
      "giver": "npc.mara",
      "recipient": "npc.cora",
      "description": "Mara has a packet of letters for Cora at Gullhook Docks, south of town. Accept the packet, carry it to Cora, and choose the quest reward when you speak with her. The letters remain physical inventory, including after a death.",
      "completion": "Cora tucks the letters into her coat. News from home is worth more than a fair tide.",
