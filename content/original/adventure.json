{
  "quests": [
    {
      "id": "quest.beacon",
      "name": "The Light Below",
      "giver": "npc.sera",
      "recipient": "npc.sera",
      "main": true,
      "description": "The Broken Beacon once guided Greyhaven ships through the reef. Its lantern heart was taken into the Drowned Cellars. Ask Orrin about the old stonework, follow the north road, and recover the heart from the Lantern Keeper. The upper-vault key and lower-ward lever open the final chamber. Bring its light back to the beacon, then return to me.",
      "completion": "The beacon burns again. Greyhaven names you Lantern Warden; the harbour can face the next dark tide.",
      "fame": 450,
      "karma": 250,
      "objectives": [
        {
          "id": "smith",
          "kind": "talk",
          "target": "npc.orrin",
          "text": "Ask Orrin about the beacon cellars",
          "amount": 1
        },
        {
          "id": "beacon",
          "kind": "visit",
          "target": "discover.beacon",
          "text": "Follow the north road to the Broken Beacon",
          "amount": 1
        },
        {
